---
// One publication row (spec §7.5 / §9.6). The data-* attributes drive the filters on /publications.
import Tag from "./ui/Tag.astro";
import { projectChips, type Publication, type ProjectLink } from "../lib/publications";

interface Props {
    pub: Publication;
    /** normKey(tab or project name) → project page */
    links: Map<string, ProjectLink>;
    headingLevel?: "h3" | "h4";
    showYear?: boolean;
    /** Project key not to show as a chip (the project page the list is on). */
    hideProject?: string;
}
const { pub, links, headingLevel: H = "h3", showYear = false, hideProject } = Astro.props;

const allProjects = projectChips(pub, links);
const projects = allProjects.filter((p) => p.key !== hideProject);

const statusTag = { Published: "live", Accepted: "default", "Under review": "warn", "": undefined } as const;
const group = pub.status === "Under review" ? "Under review" : pub.year ? String(pub.year) : "Year not listed";
---

<li
    class="pub"
    data-pub
    data-group={group}
    data-type={pub.type.toLowerCase()}
    data-status={pub.status.toLowerCase()}
    data-projects={allProjects.map((p) => p.key).join(" ")}
    data-q={`${pub.title} ${pub.venue} ${pub.authors}`.toLowerCase()}
>
    <H class="pub__title">
        {
            pub.url ? (
                <a href={pub.url} target="_blank" rel="noopener">
                    {pub.title}
                    <span class="sr-only"> (opens in a new tab)</span>
                </a>
            ) : (
                pub.title
            )
        }
    </H>
    {pub.authors && <p class="pub__authors">{pub.authors}</p>}
    {
        (pub.venue || (showYear && pub.year)) && (
            <p class="pub__venue">
                {pub.venue && <em>{pub.venue}</em>}
                {showYear && pub.year && <span>{pub.venue ? " · " : ""}{pub.year}</span>}
            </p>
        )
    }
    <div class="pub__tags">
        {pub.type && <Tag variant="outline">{pub.type}</Tag>}
        {statusTag[pub.status] && <Tag variant={statusTag[pub.status]}>{pub.status}</Tag>}
        {
            projects.map((p) =>
                p.url ? (
                    <a href={p.url} class="pub__project">
                        {p.label}
                    </a>
                ) : (
                    <span class="pub__project pub__project--plain">{p.label}</span>
                ),
            )
        }
        {pub.doi && <span class="pub__doi">DOI {pub.doi}</span>}
    </div>
</li>

<style>
    .pub {
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--color-line-soft);
    }
    .pub__title {
        font-size: 1.0625rem;
        line-height: 1.4;
        font-weight: 600;
    }
    .pub__title a {
        color: var(--color-heading);
    }
    .pub__title a:hover {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .pub__authors {
        margin-top: 0.25rem;
        font-size: 0.9375rem;
        color: var(--color-body);
    }
    .pub__venue {
        margin-top: 0.125rem;
        font-size: 0.9375rem;
        color: var(--color-muted);
    }
    .pub__tags {
        margin-top: 0.625rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.375rem;
    }
    .pub__project {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 2px 12px;
        border-radius: 8px;
        background: var(--color-soft-2);
        color: var(--color-body);
        font-size: 0.8125rem;
        font-weight: 500;
    }
    a.pub__project:hover {
        background: var(--tint);
        color: var(--tint-content);
    }
    .pub__doi {
        margin-left: 0.25rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        color: var(--color-muted);
        word-break: break-all;
    }
</style>
