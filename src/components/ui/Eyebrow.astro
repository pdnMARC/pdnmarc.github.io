---
interface Props {
    tone?: "default" | "red";
    center?: boolean;
    as?: "p" | "span" | "div";
    class?: string;
}
const { tone = "default", center = false, as: Tag = "p", class: className } = Astro.props;
---

<Tag
    class:list={[
        "eyebrow",
        tone !== "default" && `eyebrow--${tone}`,
        center && "eyebrow--center",
        className,
    ]}
>
    <slot />
</Tag>
