---
// Material 3 style buttons: filled (primary/accent), tonal, outlined, text.
import Icon from "./Icon.astro";

type Variant = "primary" | "accent" | "tonal" | "outline" | "text";

interface Props {
    href?: string;
    variant?: Variant;
    size?: "md" | "sm";
    block?: boolean;
    /** Trailing icon, e.g. "material-symbols:arrow-forward". */
    icon?: string;
    /** Leading icon. */
    iconLeading?: string;
    external?: boolean;
    type?: "button" | "submit" | "reset";
    class?: string;
    [key: string]: unknown;
}

const {
    href,
    variant = "primary",
    size = "md",
    block = false,
    icon,
    iconLeading,
    external = false,
    type = "button",
    class: className,
    ...rest
} = Astro.props;

const classes = [
    "ui-btn",
    `ui-btn--${variant}`,
    size === "sm" && "ui-btn--sm",
    block && "ui-btn--block",
    className,
]
    .filter(Boolean)
    .join(" ");
---

{
    href ? (
        <a
            href={href}
            class={classes}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
            {...rest}
        >
            {iconLeading && <Icon name={iconLeading} />}
            <span>
                <slot />
            </span>
            {icon && <Icon name={icon} />}
            {external && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
    ) : (
        <button type={type} class={classes} {...rest}>
            {iconLeading && <Icon name={iconLeading} />}
            <span>
                <slot />
            </span>
            {icon && <Icon name={icon} />}
        </button>
    )
}
