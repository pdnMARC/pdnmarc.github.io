---
// Marks content MARC still has to supply (spec §1.4 / §18).
// Rendered only by `astro dev`; production builds emit nothing.
interface Props {
    /** Spec reference, e.g. "§18". */
    ref?: string;
    class?: string;
}
const { ref, class: className } = Astro.props;
const show = import.meta.env.DEV;
---

{
    show && (
        <div class:list={["dev-todo", className]} role="note">
            <strong>✎ TODO — content from MARC{ref ? ` (${ref})` : ""}:</strong>{" "}
            <slot />
        </div>
    )
}
