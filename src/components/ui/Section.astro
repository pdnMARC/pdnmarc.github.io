---
// Section wrapper with an optional head: label + H2 + description, and a "see all"
// link on the right. Spec §9.3 / §9.10.
import Icon from "./Icon.astro";

interface Props {
    eyebrow?: string;
    eyebrowTone?: "default" | "red";
    title?: string;
    description?: string;
    cta?: { href: string; label: string };
    spacing?: "sm" | "md" | "lg";
    align?: "left" | "center";
    id?: string;
    class?: string;
}
const {
    eyebrow,
    eyebrowTone = "default",
    title,
    description,
    cta,
    spacing = "lg",
    align = "left",
    id,
    class: className,
} = Astro.props;

const padY = { sm: "py-10", md: "py-16", lg: "section-y" }[spacing];
const center = align === "center";
---

<section id={id} class:list={[padY, className]}>
    {
        (eyebrow || title || cta) && (
            <div
                class:list={[
                    "mb-10 flex gap-4",
                    center ? "flex-col items-center text-center" : "flex-col md:flex-row md:items-end md:justify-between",
                ]}
            >
                <div class:list={["max-w-[720px]", center && "mx-auto"]}>
                    {eyebrow && <p class:list={["eyebrow mb-2", eyebrowTone === "red" && "eyebrow--red"]}>{eyebrow}</p>}
                    {title && <h2 class="text-h2">{title}</h2>}
                    {description && <p class="mt-3 text-lede">{description}</p>}
                </div>
                {cta && (
                    <a href={cta.href} class="link-arrow shrink-0">
                        {cta.label}
                        <Icon name="material-symbols:arrow-forward" />
                    </a>
                )}
            </div>
        )
    }
    <slot />
</section>
