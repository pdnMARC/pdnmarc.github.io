---
interface Props {
    eyebrow?: string;
    title?: string;
    description?: string;
    cta?: { href: string; label: string };
    spacing?: "sm" | "md" | "lg";
}
const {
    eyebrow,
    title,
    description,
    cta,
    spacing = "lg",
} = Astro.props;

const padY = {
    sm: "py-10",
    md: "py-16",
    lg: "py-24 lg:py-32",
}[spacing];
---

<section class={padY}>
    {
        (eyebrow || title || cta) && (
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
                <div class="max-w-2xl">
                    {eyebrow && (
                        <p class="eyebrow text-primary mb-3">{eyebrow}</p>
                    )}
                    {title && (
                        <h2 class="font-display text-4xl md:text-5xl tracking-tight">
                            {title}
                        </h2>
                    )}
                    {description && (
                        <p class="mt-4 text-base md:text-lg text-base-content/70 leading-relaxed">
                            {description}
                        </p>
                    )}
                </div>
                {cta && (
                    <a
                        href={cta.href}
                        class="group inline-flex items-center gap-2 text-sm font-medium text-base-content hover:text-primary transition-colors"
                    >
                        {cta.label}
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 transition-transform group-hover:translate-x-1"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M5 12h14M13 5l7 7-7 7"
                            />
                        </svg>
                    </a>
                )}
            </div>
        )
    }
    <slot />
</section>
