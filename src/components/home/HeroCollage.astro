---
// Landing-page photo collage: every image in src/assets/home/ (up to 5), ordered by file name.
// Layout adapts to the count; on phones at most three tiles are shown.
import { Picture } from "astro:assets";
import { homePhotos } from "../../data/site";
import { getHomePhotos } from "../../lib/homePhotos";

const photos = getHomePhotos();
const count = photos.length;
---

{
    count > 0 && (
        <figure class="collage-wrap">
            <div class:list={["collage", `collage--${count}`]}>
                {photos.map((p, i) => (
                    <div class="collage__item">
                        <Picture
                            src={p.src}
                            alt={p.alt}
                            formats={["avif", "webp"]}
                            widths={i === 0 ? [480, 720, 960, 1280, 1600] : [320, 480, 640, 960]}
                            sizes={
                                i === 0 && count > 1
                                    ? "(max-width: 1023px) 60vw, 400px"
                                    : i === 0
                                      ? "(max-width: 1023px) 100vw, 680px"
                                      : "(max-width: 1023px) 40vw, 260px"
                            }
                            loading="eager"
                            fetchpriority={i === 0 ? "high" : "auto"}
                            class="collage__img"
                            style={p.focus ? `object-position: ${p.focus}` : undefined}
                        />
                    </div>
                ))}
            </div>
            {homePhotos.caption && <figcaption class="collage__caption">{homePhotos.caption}</figcaption>}
        </figure>
    )
}

<style>
    .collage-wrap {
        margin: 0;
    }
    .collage {
        display: grid;
        gap: 10px;
        aspect-ratio: 4 / 3;
    }
    .collage__item {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        border-radius: 20px;
        background: var(--color-soft-2);
    }
    .collage :global(picture),
    .collage :global(.collage__img) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .collage :global(.collage__img) {
        object-fit: cover;
    }
    .collage--1 .collage__item {
        border-radius: var(--radius-panel);
    }

    /* 2: side by side */
    .collage--2 {
        grid-template-columns: 1fr 1fr;
    }

    /* 3: one large, two stacked */
    .collage--3 {
        grid-template-columns: 1.35fr 1fr;
        grid-template-rows: 1fr 1fr;
    }
    .collage--3 .collage__item:first-child {
        grid-row: 1 / span 2;
    }

    /* 4: large left, wide top-right, two small bottom-right */
    .collage--4 {
        grid-template-columns: 1.4fr 1fr 1fr;
        grid-template-rows: 1fr 1fr;
    }
    .collage--4 .collage__item:nth-child(1) {
        grid-row: 1 / span 2;
    }
    .collage--4 .collage__item:nth-child(2) {
        grid-column: 2 / span 2;
    }

    /* 5: large left, 2 × 2 on the right */
    .collage--5 {
        grid-template-columns: 1.4fr 1fr 1fr;
        grid-template-rows: 1fr 1fr;
    }
    .collage--5 .collage__item:nth-child(1) {
        grid-row: 1 / span 2;
    }

    /* Phones: keep tiles a usable size — fall back to the three-photo layout. */
    @media (max-width: 640px) {
        .collage--4,
        .collage--5 {
            grid-template-columns: 1.35fr 1fr;
            grid-template-rows: 1fr 1fr;
        }
        .collage--4 .collage__item:nth-child(2) {
            grid-column: auto;
        }
        .collage--4 .collage__item:nth-child(n + 4),
        .collage--5 .collage__item:nth-child(n + 4) {
            display: none;
        }
    }

    .collage__caption {
        margin-top: 0.75rem;
        font-size: 0.875rem;
        color: var(--color-muted);
    }
</style>
