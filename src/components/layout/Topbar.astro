---
// Utility bar above the header (spec §6.2): address, email, university + social links.
// The address hides at ≤ 768px.
import Icon from "../ui/Icon.astro";
import { site, socials } from "../../data/site";
---

<div class="topbar no-print" role="region" aria-label="Contact and social links">
    <div class="container-wide topbar__inner">
        <ul class="topbar__info">
            <li class="topbar__address">
                <Icon name="material-symbols:location-on-outline" />
                <span>{site.address}</span>
            </li>
            <li>
                <a href={`mailto:${site.email}`}>
                    <Icon name="material-symbols:mail-outline" />
                    <span>{site.email}</span>
                </a>
            </li>
        </ul>
        <ul class="topbar__links">
            <li>
                <a href={site.universityUrl} target="_blank" rel="noopener" class="topbar__uni">
                    <Icon name="material-symbols:account-balance-outline" />
                    <span class="topbar__uni-text">{site.university}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                </a>
            </li>
            <li class="topbar__sep" aria-hidden="true"></li>
            {
                socials.map((s) => (
                    <li>
                        <a href={s.href} target="_blank" rel="noopener" class="topbar__icon" aria-label={`MARC on ${s.label} (opens in a new tab)`}>
                            <Icon name={s.icon} />
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</div>

<style>
    .topbar {
        background: #0c1826;
        color: #b9c6d3;
        font-size: 0.8125rem;
        line-height: 1.4;
    }
    .topbar__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 40px;
    }
    .topbar__info {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        min-width: 0;
    }
    .topbar__info li,
    .topbar__info a,
    .topbar__uni {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
    }
    .topbar__info span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .topbar a {
        transition: color var(--t-fast);
    }
    .topbar__info a:hover,
    .topbar__uni:hover {
        color: #fff;
    }
    .topbar :global(svg) {
        width: 1rem;
        height: 1rem;
        flex: none;
    }
    .topbar__info :global(svg),
    .topbar__uni :global(svg) {
        color: #7cc4e2;
    }
    .topbar__links {
        display: flex;
        align-items: center;
        gap: 0.125rem;
        flex: none;
    }
    .topbar__uni {
        padding-right: 0.5rem;
    }
    .topbar__sep {
        width: 1px;
        height: 16px;
        margin-right: 0.375rem;
        background: rgba(255, 255, 255, 0.18);
    }
    .topbar__icon {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: #d3dde6;
        transition:
            background-color var(--t-fast),
            color var(--t-fast);
    }
    .topbar__icon:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }
    @media (max-width: 960px) {
        .topbar__uni-text,
        .topbar__sep {
            display: none;
        }
    }
    @media (max-width: 768px) {
        .topbar__address {
            display: none !important;
        }
    }
</style>
