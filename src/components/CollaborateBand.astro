---
// Collaborate call-out (spec §7.1-10, C6): heading, two actions and the four audiences.
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import { site, audiences } from "../data/site";

interface Props {
    /** Where "Collaborate with us" points. */
    primaryHref?: string;
    class?: string;
}
const { primaryHref = "/contact/#message", class: className } = Astro.props;
---

<section class:list={["container-marc section-y", className]} aria-labelledby="collab-title">
    <div class="collab surface-tonal">
        <div class="collab__intro">
            <p class="eyebrow mb-2">Collaborate</p>
            <h2 id="collab-title" class="text-h2">Let's build the future of AI together</h2>
            <p class="text-lede mt-4">
                MARC welcomes researchers, academics, students, industry partners and international collaborators.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <Button href={primaryHref}>Collaborate with us</Button>
                <Button href={`mailto:${site.email}`} variant="outline" iconLeading="material-symbols:mail-outline">
                    Email MARC
                </Button>
            </div>
        </div>
        <ul class="collab__audiences">
            {
                audiences.map((a) => (
                    <li>
                        <span class="collab__icon">
                            <Icon name={a.icon} />
                        </span>
                        <h3 class="text-h4">{a.title}</h3>
                        <p class="mt-1 text-[0.9375rem]">{a.text}</p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .collab {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(2rem, 4vw, 4rem);
        align-items: center;
        padding: clamp(2rem, 5vw, 4rem);
    }
    .collab__audiences {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }
    .collab__audiences li {
        padding: 1.5rem;
        border-radius: var(--radius-card);
        background: var(--color-base-100);
    }
    :global([data-theme="marc-dark"]) .collab__audiences li {
        background: var(--color-soft-2);
    }
    .collab__icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        margin-bottom: 1rem;
        border-radius: 50%;
        background: var(--tint);
        color: var(--tint-content);
    }
    .collab__icon :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
    }
    @media (max-width: 992px) {
        .collab {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 480px) {
        .collab__audiences {
            grid-template-columns: 1fr;
        }
    }
</style>
