---
// Research area card (spec §9.4): cover, area icon in its accent colour, title, summary, link.
// The whole card is one link.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./ui/Icon.astro";
import type { Accent } from "../lib/research";

interface Props {
    title: string;
    href: string;
    number?: string;
    image?: ImageMetadata;
    summary?: string;
    icon?: string;
    accent?: Accent;
    /** e.g. "4 projects" */
    meta?: string;
    headingLevel?: "h2" | "h3";
}
const { title, href, image, summary, icon, accent = "blue", meta, headingLevel: H = "h3" } = Astro.props;
---

<a href={href} class:list={["area-card group card-surface surface-hover", `acc-${accent}`]}>
    <div class="area-card__media">
        {
            image && (
                <Image
                    src={image}
                    alt=""
                    widths={[400, 640, 880]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1080px) 50vw, 420px"
                    class="area-card__img"
                />
            )
        }
    </div>
    <div class="area-card__body">
        {icon && <span class="acc-chip area-card__chip"><Icon name={icon} /></span>}
        <H class="text-h3">{title}</H>
        {meta && <p class="acc-label mt-1">{meta}</p>}
        {summary && <p class="area-card__summary">{summary}</p>}
        <span class="link-arrow mt-auto pt-5">
            Learn more <Icon name="material-symbols:arrow-forward" />
        </span>
    </div>
</a>

<style>
    .area-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }
    .area-card__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--color-soft-2);
    }
    .area-card :global(.area-card__img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--t-slow) var(--ease-brand);
    }
    .area-card:hover :global(.area-card__img) {
        transform: scale(1.04);
    }
    .area-card__body {
        position: relative;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        padding: 2.25rem 1.5rem 1.5rem;
    }
    .area-card :global(.area-card__chip) {
        position: absolute;
        top: -22px;
        left: 1.5rem;
        box-shadow: 0 0 0 4px var(--color-base-100);
    }
    :global([data-theme="marc-dark"]) .area-card :global(.area-card__chip) {
        box-shadow: 0 0 0 4px var(--color-soft);
    }
    .area-card__summary {
        margin-top: 0.5rem;
        font-size: 0.9375rem;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
