---
import logo from "../assets/logo.png";
import { Image } from "astro:assets";

const links = [
    { href: "/", label: "About" },
    { href: "/Research", label: "Research" },
    { href: "/projects", label: "Projects" },
    { href: "/publications", label: "Publications" },
    { href: "/people", label: "People" },
    { href: "/news", label: "News" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
    if (href === "/") return path === "/";
    return path === href || path.startsWith(href + "/");
};
---

<header
    class="sticky top-0 z-50 backdrop-blur-xl bg-base-100/80 border-b border-base-200"
>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-20">
            <!-- Brand -->
            <a href="/" class="flex items-center gap-3 group">
                <Image
                    src={logo}
                    alt="MARC logo"
                    class="w-10 h-10 rounded-full ring-1 ring-base-300 group-hover:ring-primary transition"
                />
                <div class="leading-tight hidden sm:block">
                    <div class="text-base font-semibold tracking-tight">
                        MARC
                    </div>
                    <div class="text-xs text-base-content/60">
                        Multidisciplinary AI Research Centre
                    </div>
                </div>
            </a>

            <!-- Desktop nav -->
            <nav class="hidden lg:flex items-center gap-1">
                {
                    links.map((l) => (
                        <a
                            href={l.href}
                            class={`relative px-4 py-2 text-sm font-medium rounded-full transition-colors ${
                                isActive(l.href)
                                    ? "text-base-content"
                                    : "text-base-content/60 hover:text-base-content"
                            }`}
                        >
                            {l.label}
                            {isActive(l.href) && (
                                <span class="absolute inset-x-4 -bottom-0.5 h-0.5 bg-gradient-to-r from-primary to-accent rounded-full" />
                            )}
                        </a>
                    ))
                }
            </nav>

            <!-- Right cluster: theme toggle + mobile menu button -->
            <div class="flex items-center gap-2">
                <button
                    id="theme-toggle"
                    class="btn btn-ghost btn-sm btn-circle"
                    aria-label="Toggle theme"
                    type="button"
                >
                    <svg
                        class="w-5 h-5 hidden dark:hidden"
                        id="theme-icon-light"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <circle cx="12" cy="12" r="4"></circle>
                        <path
                            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                        ></path>
                    </svg>
                    <svg
                        class="w-5 h-5"
                        id="theme-icon-dark"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                        ></path>
                    </svg>
                </button>

                <button
                    id="mobile-menu-toggle"
                    class="lg:hidden btn btn-ghost btn-sm btn-circle"
                    aria-label="Open menu"
                    type="button"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4">
            <nav class="flex flex-col gap-1">
                {
                    links.map((l) => (
                        <a
                            href={l.href}
                            class={`px-4 py-3 rounded-lg text-sm font-medium transition-colors ${
                                isActive(l.href)
                                    ? "bg-base-200 text-base-content"
                                    : "text-base-content/70 hover:bg-base-200"
                            }`}
                        >
                            {l.label}
                        </a>
                    ))
                }
            </nav>
        </div>
    </div>
</header>

<script is:inline>
    const root = document.documentElement;
    const toggle = document.getElementById("theme-toggle");
    const iconSun = document.getElementById("theme-icon-light");
    const iconMoon = document.getElementById("theme-icon-dark");

    const syncIcons = () => {
        const isDark = root.getAttribute("data-theme") === "marc-dark";
        if (iconSun && iconMoon) {
            iconSun.classList.toggle("hidden", !isDark);
            iconMoon.classList.toggle("hidden", isDark);
        }
    };
    syncIcons();

    toggle?.addEventListener("click", () => {
        const next =
            root.getAttribute("data-theme") === "marc-dark"
                ? "marc"
                : "marc-dark";
        root.setAttribute("data-theme", next);
        try {
            localStorage.setItem("marc-theme", next);
        } catch (_) {}
        syncIcons();
    });

    const menuBtn = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    menuBtn?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
    });
</script>
