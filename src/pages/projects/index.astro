---
// Projects (spec §7.4): every project is rendered at build time; the area chips only filter
// them (without JS all projects are shown and the chips are hidden).
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/ui/Icon.astro";
import { getResearchAreas, areaMeta } from "../../lib/research";
import { publicationsForProject } from "../../lib/publications";

const areas = getResearchAreas();
const order = (title: string) => {
    const i = areas.findIndex((a) => a.title === title);
    return i === -1 ? areas.length : i;
};
const projects = (await getCollection("projects")).sort(
    (a, b) => order(a.data.researchArea) - order(b.data.researchArea) || a.data.project.localeCompare(b.data.project),
);
const papers = new Map(
    await Promise.all(projects.map(async (p) => [p.id, (await publicationsForProject(p)).length] as const)),
);
const chips = areas
    .map((a) => ({ ...a, count: projects.filter((p) => p.data.researchArea === a.title).length }))
    .filter((a) => a.count > 0);
---

<BaseLayout
    title="Research Projects"
    description="Research projects at the Multidisciplinary AI Research Centre, University of Peradeniya."
    breadcrumbs={[{ label: "Projects" }]}
    header={{
        eyebrow: "Research Projects",
        eyebrowTone: "red",
        title: "Transforming Research into Real-World Impact",
        subtitle: `${projects.length} ${projects.length === 1 ? "project" : "projects"} across MARC's research areas.`,
    }}
>
    <div class="js-only mb-8" data-area-filter>
        <div role="group" aria-label="Filter projects by research area" class="flex flex-wrap gap-2">
            <button type="button" class="area-chip" data-area="" aria-pressed="true">
                All areas <span class="area-chip__count">{projects.length}</span>
            </button>
            {
                chips.map((a) => (
                    <button type="button" class:list={["area-chip", `acc-${a.accent}`]} data-area={a.slug} aria-pressed="false">
                        <Icon name={a.icon} />
                        {a.title}
                        <span class="area-chip__count">{a.count}</span>
                    </button>
                ))
            }
        </div>
        <p class="mt-4 text-sm text-muted" aria-live="polite">
            Showing <strong class="text-heading" data-shown>{projects.length}</strong> of {projects.length} projects
        </p>
    </div>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 nav:grid-cols-3 lg:gap-8">
        {
            projects.map((project, i) => (
                <li class="reveal" style={`--reveal-delay:${(i % 3) * 70}ms`} data-area={areaMeta(project.data.researchArea).slug ?? ""}>
                    <ProjectCard project={project} papers={papers.get(project.id)} headingLevel="h2" />
                </li>
            ))
        }
    </ul>
</BaseLayout>

<script>
    const root = document.querySelector<HTMLElement>("[data-area-filter]");
    if (root) {
        const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-area]"));
        const items = Array.from(document.querySelectorAll<HTMLElement>("li[data-area]"));
        const shown = root.querySelector<HTMLElement>("[data-shown]");
        const apply = (area: string) => {
            for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.area === area));
            let n = 0;
            for (const li of items) {
                const ok = !area || li.dataset.area === area;
                li.hidden = !ok;
                if (ok) {
                    n++;
                    li.classList.add("is-in");
                }
            }
            if (shown) shown.textContent = String(n);
            const url = new URL(location.href);
            if (area) url.searchParams.set("area", area);
            else url.searchParams.delete("area");
            history.replaceState(null, "", url.pathname + url.search);
        };
        for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.area ?? ""));
        const initial = new URLSearchParams(location.search).get("area") ?? "";
        if (buttons.some((b) => b.dataset.area === initial)) apply(initial);
    }
</script>

<style>
    .area-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 40px;
        padding: 0 0.875rem;
        border-radius: 999px;
        border: 1px solid var(--color-line);
        background: var(--color-base-100);
        color: var(--color-body);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition:
            background-color var(--t-fast),
            border-color var(--t-fast),
            color var(--t-fast);
    }
    .area-chip :global(svg) {
        width: 1.125rem;
        height: 1.125rem;
        color: var(--acc, var(--color-primary));
    }
    .area-chip:hover {
        background: var(--state);
    }
    .area-chip[aria-pressed="true"] {
        background: var(--acc-bg, var(--tint));
        border-color: transparent;
        color: var(--acc, var(--tint-content));
    }
    .area-chip__count {
        font-size: 0.8125rem;
        opacity: 0.8;
    }
</style>
