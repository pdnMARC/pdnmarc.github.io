---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const links = [
    { href: "/research/", label: "Research areas" },
    { href: "/projects/", label: "Projects" },
    { href: "/publications/", label: "Publications" },
    { href: "/people/", label: "People" },
    { href: "/contact/", label: "Contact" },
];
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." width="full" noindex>
    <!-- Old links used capitalised paths (/Research/…); URLs are lowercase now (decision D10). -->
    <script is:inline>
        (() => {
            const p = location.pathname;
            if (p !== p.toLowerCase()) location.replace(p.toLowerCase() + location.search + location.hash);
        })();
    </script>

    <section class="container-narrow section-y">
        <p class="eyebrow">Error 404</p>
        <h1 class="text-page-title mt-2">We couldn't find that page</h1>
        <p class="text-lede mt-4 max-w-xl">
            The link may be out of date, or the page may have moved when the site was reorganised.
        </p>
        <div class="mt-8">
            <Button href="/">Go to the home page</Button>
        </div>
        <h2 class="text-h4 mt-14">Or try one of these</h2>
        <ul class="mt-4 grid gap-1 sm:grid-cols-2">
            {
                links.map((l) => (
                    <li>
                        <a href={l.href} class="text-primary hover:underline">
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
