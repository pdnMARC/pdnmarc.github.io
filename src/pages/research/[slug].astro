---
// Research area detail (spec §7.3). Cover image goes through astro:assets (fixes B5).
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/ui/Prose.astro";
import Icon from "../../components/ui/Icon.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getResearchAreas, type ResearchArea } from "../../lib/research";
import { publicationsForProject } from "../../lib/publications";

export function getStaticPaths() {
    const areas = getResearchAreas();
    return areas.map((area, i) => ({
        params: { slug: area.slug },
        props: { area, prev: areas[i - 1], next: areas[i + 1] },
    }));
}

interface Props {
    area: ResearchArea;
    prev?: ResearchArea;
    next?: ResearchArea;
}
const { area, prev, next } = Astro.props;
const { Content } = area;

const projects = await getCollection("projects");
const related = projects
    .filter((p) => p.data.researchArea === area.title)
    .sort((a, b) => a.data.project.localeCompare(b.data.project));
const papers = new Map(await Promise.all(related.map(async (p) => [p.id, (await publicationsForProject(p)).length] as const)));
---

<BaseLayout
    title={area.title}
    description={area.short.slice(0, 158)}
    breadcrumbs={[{ label: "Research areas", href: "/research/" }, { label: area.title }]}
>
    <header class:list={["flex max-w-4xl items-start gap-5", `acc-${area.accent}`]}>
        <span class="acc-chip acc-chip--lg mt-1 hidden sm:grid"><Icon name={area.icon} /></span>
        <div>
            <p class="acc-label text-[0.9375rem]">Research area</p>
            <h1 class="text-page-title mt-1">{area.title}</h1>
        </div>
    </header>

    {
        area.cover && (
            <div class="mt-8 overflow-hidden rounded-[var(--radius-panel)] bg-soft-2">
                <Image
                    src={area.cover}
                    alt=""
                    widths={[768, 1280, 1600]}
                    sizes="(max-width: 1296px) 100vw, 1296px"
                    loading="eager"
                    fetchpriority="high"
                    class="aspect-[3/1] w-full object-cover"
                />
            </div>
        )
    }

    <div class="mt-12 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-8">
            <Prose>
                <Content />
            </Prose>
        </div>
        <aside class="lg:col-span-4" aria-label="About this area">
            <div class="card-surface p-6 lg:sticky lg:top-24">
                <p class="text-sm text-muted">Related projects</p>
                <p class="mt-1 font-head text-3xl font-semibold text-heading">{related.length}</p>
                <a href="/research/" class="link-arrow mt-5">
                    All research areas <Icon name="material-symbols:arrow-forward" />
                </a>
            </div>
        </aside>
    </div>

    {
        related.length > 0 && (
            <section class="mt-16 border-t border-line-soft pt-12" aria-labelledby="related-projects">
                <h2 id="related-projects" class="text-h2">
                    Related projects
                </h2>
                <ul class="mt-8 grid gap-6 md:grid-cols-2 nav:grid-cols-3">
                    {related.map((project, i) => (
                        <li class="reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
                            <ProjectCard project={project} papers={papers.get(project.id)} />
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <nav class="mt-16 grid gap-4 border-t border-line-soft pt-8 sm:grid-cols-2" aria-label="Other research areas">
        {
            prev ? (
                <a href={prev.url} class="group flex flex-col gap-1">
                    <span class="text-sm text-muted">Previous area</span>
                    <span class="text-h4 font-semibold text-primary group-hover:underline">{prev.title}</span>
                </a>
            ) : (
                <span />
            )
        }
        {
            next && (
                <a href={next.url} class="group flex flex-col gap-1 sm:text-right">
                    <span class="text-sm text-muted">Next area</span>
                    <span class="text-h4 font-semibold text-primary group-hover:underline">{next.title}</span>
                </a>
            )
        }
    </nav>
</BaseLayout>
